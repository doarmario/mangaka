# Copie para .env e substitua as três chaves/senhas abaixo por valores aleatórios.
SECRET_KEY=troque-por-uma-chave-aleatoria
DB_USER=mangaka
DB_PASSWORD=troque-por-uma-senha-aleatoria
DB_NAME=mangaka
MYSQL_ROOT_PASSWORD=troque-por-outra-senha-aleatoria
MANGAKA_PORT=5000
# Use 0.0.0.0 para acessar de outros dispositivos na mesma rede local.
MANGAKA_BIND_ADDRESS=127.0.0.1
# Endereços dentro da rede do Compose (não são portas publicadas no host).
DB_HOST=mysql
REDIS_HOST_CACHE=redis://redis:6379/0
REDIS_HOST_SESSION=redis://redis:6379/1
# Ao executar sem Compose, configure QISCANS_API_URL com a URL do wrapper (ex.: http://127.0.0.1:3002).
# Checkout preservado da API adicional, relativo a compose.yaml:
MANGA_NOVEL_SOURCE_DIR=../manga-novel-api
# Intervalo do worker de novidades, em segundos (30 minutos por padrão).
UPDATES_INTERVAL_SECONDS=1800
# Intervalo do atualizador opcional em Docker (mínimo 60 segundos).
AUTO_UPDATE_INTERVAL_SECONDS=300

# API Demonic Scans (fora do Docker Compose; no Compose já é configurada)
# DEMONICSCANS_API_URL=http://localhost:3003

# Thunder Scans fora do Compose (a URL interna já é configurada automaticamente)
# THUNDERSCANS_API_URL=http://localhost:3004

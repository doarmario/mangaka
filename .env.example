# Copie para .env e substitua as três chaves/senhas abaixo por valores aleatórios.
SECRET_KEY=troque-por-uma-chave-aleatoria
DB_USER=mangaka
DB_PASSWORD=troque-por-uma-senha-aleatoria
DB_NAME=mangaka
MYSQL_ROOT_PASSWORD=troque-por-outra-senha-aleatoria
MANGAKA_PORT=5000
# Endereços dentro da rede do Compose (não são portas publicadas no host).
DB_HOST=mysql
REDIS_HOST_CACHE=redis://redis:6379/0
REDIS_HOST_SESSION=redis://redis:6379/1
# Checkout preservado da API adicional, relativo a compose.yaml:
MANGA_NOVEL_SOURCE_DIR=../manga-novel-api
